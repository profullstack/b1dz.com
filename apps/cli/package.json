  "description": "b1dz CLI and TUI: crypto arbitrage terminal for b1dz.com (dashboard, backtests, quote observer, account setup).",
  "type": "module",
  "bin": {
    "b1dz": "./dist/b1dz.js"
  },
  "files": [
    "dist/b1dz.js",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://b1dz.com",

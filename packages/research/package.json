{
  "name": "@b1dz/research",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Market research cards for b1dz: equities, options, rates, credit, FX, futures, energy, shipping, macro, filings and news from public and official sources. One registry, rendered by the TUI, CLI, API and MCP.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./format": {
      "import": "./src/format.ts",
      "default": "./src/format.ts"
    },
    "./transform": {
      "import": "./src/transform.ts",
      "default": "./src/transform.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}

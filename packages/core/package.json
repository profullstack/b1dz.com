{
  "name": "@b1dz/core",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./catalog": {
      "import": "./src/plugin-catalog.ts",
      "default": "./src/plugin-catalog.ts"
    },
    "./storage-contract": {
      "import": "./src/storage-contract.ts",
      "default": "./src/storage-contract.ts"
    },
    "./sealed-secrets": {
      "import": "./src/sealed-secrets.ts",
      "default": "./src/sealed-secrets.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@profullstack/pluginstore": "^0.1.2",
    "redis": "6.3.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
